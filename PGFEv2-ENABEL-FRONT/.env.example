# Backend local (défaut si absent). Cross-origin: Laravel CORS must allow this Vite origin
# (FRONTEND_URL / patterns in PGFEv2-ENABEL — vite binds http://127.0.0.1:5173).
VITE_API_BASE_URL=http://localhost:8000/api/v1/
VITE_SANCTUM_BASE_URL=http://localhost:8000/

# Production same-origin (front built into Laravel public/) : use relative paths
# VITE_API_BASE_URL=/api/v1/
# VITE_SANCTUM_BASE_URL=/

# Production (exemple cross-origin)
# VITE_API_BASE_URL=https://pgfe-back.inafrica.tech/api/v1/
# VITE_SANCTUM_BASE_URL=https://pgfe-back.inafrica.tech/
